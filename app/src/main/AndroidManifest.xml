<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- NetworkGate: wait for the Ethernet link before starting ROS, restart when it changes -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoomoROS2Bridge"
        tools:targetApi="22">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.LoomoROS2Bridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ProcessPhoenix's restart activity (NetworkGate.restart). The library declares it in its
             own process. Here it also gets its own task: launched from MainActivity, it would
             otherwise join MainActivity's task, and finishAndRemoveTask() would remove it too. -->
        <activity
            android:name="com.jakewharton.processphoenix.PhoenixActivity"
            android:taskAffinity="com.autom8ed.lr2.phoenix"
            android:excludeFromRecents="true"
            tools:node="merge" />
        <receiver android:name="IntentReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.segway.robot.action.TO_ROBOT" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>